# Example environment for the SAP MCP servers. Copy to `.env` and fill in.
# Values shown are placeholders - the authoritative defaults live in
# sap_odata/config.py and sap_b1/config.py. Nothing here is needed to run the
# local mock tests (tests/verify_stack.py, tests/verify_b1.py set their own env).

# ---------------------------------------------------------------- OData server
SAP_BASE_URL=https://sandbox.api.sap.com
SAP_ODATA_PATH=/sap/opu/odata/sap
SAP_ODATA_VERSION=2
SAP_AUTH_TYPE=apikey          # apikey | basic | oauth2
SAP_APIKEY=
SAP_USERNAME=
SAP_PASSWORD=
SAP_CLIENT=
SAP_LABEL=sandbox
SAP_TIMEOUT=30
SAP_PAGE_SIZE=50
SAP_MAX_PAGES=20
# Optional: a config file holding SAP_CONFIG_FILE profiles instead of env vars
# SAP_CONFIG_FILE=/etc/sap-connector/profiles.json

# Governance gate - writes stay blocked until this is 1
SAP_WRITE_ENABLED=0

# ------------------------------------------------------- Business One server
SAP_B1_BASE_URL=https://b1host:50000/b1s/v1
SAP_B1_COMPANY_DB=SBODEMO
SAP_B1_USERNAME=
SAP_B1_PASSWORD=
SAP_B1_LANGUAGE=23
SAP_B1_TIMEOUT=30

# Governance gate - writes stay blocked until this is 1
SAP_B1_WRITE_ENABLED=0
